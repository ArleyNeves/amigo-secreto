rules_version = '2';

// Regras do banco de dados do Amigo Secreto.
// Cole este conteúdo em: Console do Firebase > Firestore Database > Regras > Publicar.

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    // Mesma lista de ORGANIZADORES do firebase-config.js
    function isAdmin() {
      return signedIn()
        && request.auth.token.email_verified == true
        && request.auth.token.email.lower() in [
          'arleyneves.an@gmail.com'
        ];
    }

    function str(v, max) {
      return v is string && v.size() <= max;
    }

    // Detalhes do evento: todos leem, só organizadores editam
    match /config/evento {
      allow read: if true;
      allow delete: if isAdmin();
      allow create, update: if isAdmin()
        && request.resource.data.keys().hasOnly(['data', 'valor', 'local', 'obs', 'afiliados'])
        && str(request.resource.data.data, 10)
        && str(request.resource.data.valor, 30)
        && str(request.resource.data.local, 80)
        && str(request.resource.data.obs, 300)
        && request.resource.data.afiliados is map
        && request.resource.data.afiliados.keys().hasOnly(['mercadolivre', 'amazon', 'shopee', 'shein']);
    }

    // Lista de cada pessoa: o documento tem o ID da conta de quem é dono.
    // Todos leem; só o dono cria e edita; o dono ou um organizador apaga.
    match /pessoas/{uid} {
      allow read: if true;
      allow create, update: if signedIn()
        && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['nome', 'itens', 'atualizadoEm', 'foto'])
        && (!('foto' in request.resource.data)
            || (request.resource.data.foto is string
                && request.resource.data.foto.size() <= 60000
                && request.resource.data.foto.matches('data:image/jpeg;base64,[A-Za-z0-9+/=]+')))
        && request.resource.data.nome is string
        && request.resource.data.nome.size() > 0
        && request.resource.data.nome.size() <= 40
        && request.resource.data.itens is list
        && request.resource.data.itens.size() <= 30
        && str(request.resource.data.atualizadoEm, 40);
      allow delete: if signedIn() && (request.auth.uid == uid || isAdmin());
    }

    // Qualquer outro caminho é bloqueado
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
